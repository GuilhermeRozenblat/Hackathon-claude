# Copie para .env e preencha. O .env é ignorado pelo git e o bot exige permissão 0600.
# NUNCA commite valor real, nem cole token em issue, PR ou print.

# Obrigatório: token do @BotFather. Veja TELEGRAM.md
TELEGRAM_TOKEN=coloque-o-token-do-BotFather

# Opcional: sem isso o bot usa os textos escritos à mão em creche_bot/ia/persona.py
# e funciona igual. Ligue quando quiser a variação de linguagem do Claude.
ANTHROPIC_API_KEY=

# Postgres local (docker compose up). Gere um valor só seu:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
